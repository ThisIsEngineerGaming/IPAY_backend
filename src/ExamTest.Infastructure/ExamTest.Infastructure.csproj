<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to Microsoft.AspNetCore.Http (IFormFile, etc.) used in CloudinaryImageService.
         Only the entry-point Web SDK project gets this automatically; class libraries need it explicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to match Domain, to avoid NU1605 "package downgrade" errors. -->
    <PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.*" />

    <PackageReference Include="CloudinaryDotNet" Version="1.*" />

    <!-- Class libraries (unlike the Web SDK project) don't get these for free -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExamTest.Domain\ExamTest.Domain.csproj" />
  </ItemGroup>

</Project>
