core.repositoryformatversion=0
core.filemode=false
core.bare=false
core.logallrefupdates=true
core.symlinks=false
core.ignorecase=true
remote.origin.url=https://github.com/ThisIsEngineerGaming/IPAY_backend.git
remote.origin.fetch=+refs/heads/*:refs/remotes/origin/*
branch.master.remote=origin
branch.master.merge=refs/heads/master
branch.feature/programm.remote=origin
branch.feature/programm.merge=refs/heads/feature/programm
branch.feature/branch_to_fix.remote=origin
branch.feature/branch_to_fix.merge=refs/heads/feature/branch_to_fix
branch.main_branch.remote=origin
branch.main_branch.merge=refs/heads/main_branch
branch.test_branch.remote=origin
branch.test_branch.merge=refs/heads/test_branch
branch.head_branch.remote=origin
branch.head_branch.merge=refs/heads/head_branch
